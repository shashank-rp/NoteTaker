<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        >

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtHeadingBuyerMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark*"
            android:autoSizeMaxTextSize="16sp"
            android:textColor="@color/indigo_dye"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtInputBuyerMark"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textSize="12sp"
            android:textAlignment="viewStart"
            android:capitalize="characters"
            android:maxLength="8"
            android:nextFocusForward="@id/txtInputBidQuantity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@+id/txtHeadingBuyerMark">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="8"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtHeadingBidQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Quantity*"
            android:autoSizeMaxTextSize="16sp"
            android:textColor="@color/indigo_dye"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtInputBuyerMark" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtInputBidQuantity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textSize="12sp"
            android:maxLength="8"
            android:nextFocusForward="@id/txtInputBidRate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@+id/txtHeadingBidQuantity">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="8"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtHeadingBidRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Base rate*"
            android:autoSizeMaxTextSize="16sp"
            android:textColor="@color/indigo_dye"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtInputBidQuantity" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtInputBidRate"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textSize="12sp"
            android:maxLength="8"
            android:nextFocusForward="@id/txtInputAdditionalPrice"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.30"
            app:layout_constraintTop_toBottomOf="@+id/txtHeadingBidRate"
            android:textAlignment="viewEnd"
            app:prefixText="₹">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLength="8"
                android:imeOptions="actionNext"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtHeadingBidAddtionalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Extra amount"
            android:autoSizeMaxTextSize="16sp"
            android:textColor="@color/indigo_dye"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/txtInputAdditionalPrice"
            app:layout_constraintTop_toBottomOf="@id/txtInputBidQuantity" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtInputAdditionalPrice"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLength="8"
            android:layout_marginEnd="16dp"
            android:nextFocusForward="@id/txtInputBidTokenAdvance"
            app:layout_constraintStart_toEndOf="@id/txtInputBidRate"
            app:layout_constraintWidth_percent="0.30"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toStartOf="@id/txtInputTotal"
            app:layout_constraintTop_toBottomOf="@+id/txtHeadingBidRate"
            android:textAlignment="viewEnd"
            app:prefixText="₹">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtAditionalPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="8"
                android:inputType="numberDecimal"/>

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total rate"
            android:textSize="16sp"
            android:autoSizeMaxTextSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:textColor="@color/indigo_dye"
            app:layout_constraintTop_toBottomOf="@+id/txtInputBidQuantity"
            app:layout_constraintStart_toStartOf="@+id/txtInputTotal"
            />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtInputTotal"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLength="8"
            app:layout_constraintWidth_percent="0.30"
            android:layout_marginEnd="4dp"
            app:layout_constraintTop_toBottomOf="@+id/txtHeadingBidRate"
            app:layout_constraintEnd_toEndOf="parent"
            android:textAlignment="viewEnd"
            app:prefixText="₹">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtTotalEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="8"
                android:inputType="numberDecimal"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtHeadingBidTokenAdvance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Token Advance"
            android:autoSizeMaxTextSize="16sp"
            android:textColor="@color/indigo_dye"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtInputBidRate" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtInputBidTokenAdvance"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="50sp"
            android:textSize="12sp"
            android:maxLength="8"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideline3"
            app:layout_constraintTop_toBottomOf="@+id/txtHeadingBidTokenAdvance"
            android:textAlignment="viewEnd">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/txtAdvance"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLength="8"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/indigo_dye"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cornerRadius="4dp"
            android:textStyle="bold"
            android:text="dialog"
            android:capitalize="words"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>